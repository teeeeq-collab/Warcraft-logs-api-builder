# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit it, paste it into a chat assistant,
# screenshot it, or include it in a bug report.
#
# Create an API client at: https://www.warcraftlogs.com/api/clients/
# (v2 Public API, OAuth "client credentials" flow. No redirect URL needed.)

WCL_CLIENT_ID=your-client-id-here
WCL_CLIENT_SECRET=your-client-secret-here

# --- Optional: override defaults (all have sane built-in values) ---

# WCL_API_URL=https://www.warcraftlogs.com/api/v2/client
# WCL_TOKEN_URL=https://www.warcraftlogs.com/oauth/token

# Local storage locations (relative paths resolve against the project root).
# WCLMPLUS_DATA_DIR=data

# Politeness / safety. Conservative defaults; raise only with evidence.
# WCLMPLUS_CONCURRENCY=2
# WCLMPLUS_MIN_POINTS_RESERVE=200
# WCLMPLUS_MAX_RETRIES=5
# WCLMPLUS_TIMEOUT_SECONDS=60
